# # =====================================================
# #  E-COMMERCE BYTE-WISE ENVIRONMENT VARIABLES
# # =====================================================

# # ===========================
# #  DATABASE
# # ===========================
# MONGODB_URI=mongodb://localhost:27017/ecommerce

# # ===========================
# #  AUTHENTICATION
# # ===========================
# NEXTAUTH_SECRET=your-nextauth-secret
# NEXTAUTH_URL=http://localhost:3000
# # Secret used to sign httpOnly session cookies (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
# SESSION_SECRET=your-strong-32-plus-char-secret
# # Initial admin account, used by `npm run seed:admin`
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD=a-strong-admin-password
# # Shared secret for scheduled jobs under /api/cron/*. Required — the routes
# # refuse to run without it. Vercel Cron sends it as `Authorization: Bearer <secret>`.
# # Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# CRON_SECRET=your-strong-32-plus-char-cron-secret

# # ===========================
# #  GOOGLE OAUTH (Optional)
# # ===========================
# # Get these from https://console.cloud.google.com/apis/credentials
# # Create an OAuth 2.0 Client ID (Web application)
# # Authorized redirect URI: http://localhost:3000/api/auth/google/callback
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# # ===========================
# #  RAZORPAY CONFIG
# # ===========================
# Required when RAZORPAY_ENABLED=true. Obtain both from Razorpay Dashboard
# > Settings > API Keys. Use test keys for testing and live keys for production.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Website checkout gateways. These are SERVER variables (not NEXT_PUBLIC).
# Pine Labs is preferred when enabled; explicitly choose another enabled
# provider with PAYMENT_DEFAULT_PROVIDER. This sample enables only Razorpay.
RAZORPAY_ENABLED=true
PINELABS_ENABLED=false
PAYTM_ENABLED=false
PAYMENT_DEFAULT_PROVIDER=razorpay
# Show "In-store Purchase" at checkout only when exactly true; unset or false hides it.
INSTORE_PURCHASE_ENABLED=false

# Pine Labs: ALL four fields below are required when PINELABS_ENABLED=true.
# Obtain MID, OAuth client ID and OAuth client secret from the onboarding email
# or merchant dashboard. Use matching UAT or production credentials.
PINELABS_ENVIRONMENT=uat
# Merchant ID (MID).
PINELABS_MERCHANT_ID=
# OAuth client ID; used by the server to request an access token.
PINELABS_CLIENT_ID=
# OAuth client secret; do not assume it is also the callback signing key.
PINELABS_CLIENT_SECRET=
# REQUIRED: hexadecimal secret_key used for Hosted Checkout return signatures.
# Ask Pine Labs onboarding/PG support which key to use and whether it differs
# from the OAuth secret. Do not generate a substitute.
# Payments cannot start while this is blank.
PINELABS_CALLBACK_SECRET=

# Paytm: MID and merchant key are required when PAYTM_ENABLED=true.
# Obtain the matching pair from Paytm merchant dashboard/onboarding.
# Keep Paytm disabled until both are configured; never reuse Pine/Razorpay keys.
PAYTM_ENVIRONMENT=uat
# Merchant ID (MID); staging for UAT, production for go-live.
PAYTM_MERCHANT_ID=
# Paytm-issued 16-byte merchant key.
PAYTM_MERCHANT_KEY=
# Optional; defaults to WEBSTAGING in UAT and DEFAULT in production.
PAYTM_WEBSITE_NAME=
# Hosted gateways also require NEXT_PUBLIC_SITE_URL as a public HTTPS origin.
# Whitelist return/webhook URLs with each provider; see:
# documents/operations/website-payment-gateways.md

# # ===========================
# #  EMAIL (SMTP)
# # ===========================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# # Variable names below must match exactly — lib/email.ts reads SMTP_PASS and EMAIL_FROM.
# SMTP_PASS=your-app-password
# EMAIL_FROM=your-email@gmail.com
# VENDOR_EMAIL=vendor@example.com

# # ===========================
# #  SITE URL
# # ===========================
# # Required in production: app/sitemap.ts, canonicals and email links fall back to
# # localhost without it, which ships localhost URLs to Google.
# NEXT_PUBLIC_SITE_URL=https://www.example.com
# # Keep these three URL variables on the same HTTPS production origin.
# NEXT_PUBLIC_APP_URL=https://www.example.com
# # NEXTAUTH_URL is shown in the authentication section above.
# # Optional isolated database selection; never point audit scripts at live data.
# MONGODB_DB=
# # Checkout now requires MongoDB replica-set transactions, including local development.
# # Configure a durable rate-limit store before a multi-instance deployment.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# # ===========================
# #  MARKETING & ANALYTICS TAGS  (components/MarketingTags.tsx)
# # ===========================
# # Set GTM *or* GA4, never both — configure GA4 inside the container when using GTM,
# # otherwise every e-commerce event is counted twice.
# # GA4/Clarity require analytics consent, Meta requires advertising consent.
# # An unrestricted GTM container requires both; withdrawing consent reloads the page.
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=000000000000000
# NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx

# # ===========================
# #  GOOGLE SHEET SYNC
# # ===========================
# NEXT_PUBLIC_GOOGLE_SHEET_PRICE_SYNC_ID=your-google-sheet-id

# # ===========================
# #  PARTNER API CONFIGURATION
# # ===========================
# # 32-byte encryption key for partner API keys (IMPORTANT: Change in production!)
# PARTNER_API_KEY_SECRET=your-32-byte-encryption-key-here

# # ===========================
# #  PARTNER ALLOWED ORIGINS
# # ===========================
# # Comma-separated list of domains that can access Partner API from browsers
# # Supports wildcards: *.example.com, localhost:*
# # 
# # IMPORTANT: Due to Vercel Attack Challenge Mode, partners should use 
# # SERVER-SIDE API calls instead of browser-based calls.
# # 
# # Server-to-server requests bypass Vercel's bot protection and don't need
# # to be listed here. Only add origins if you explicitly want to allow
# # browser-based API calls (not recommended for production).
# #
# # Examples:
# #   - http://localhost:3000
# #   - https://partner-website.com
# #   - https://*.vercel.app
# #   - https://*.partner-domain.com
# #
# PARTNER_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# # ===========================
# #  VERCEL (Production Only)
# # ===========================
# # Add these to your Vercel Environment Variables for production:

# # - All the above variables
# # - PARTNER_ALLOWED_ORIGINS with your partner domains

# ===========================================================================
#  DPDP ACT 2023 COMPLIANCE  (REQUIRED BEFORE GOING LIVE)
# ===========================================================================
# These are NOT optional. Section 5 of the Digital Personal Data Protection
# Act requires the Data Fiduciary and its Grievance Officer to be named in the
# privacy notice. Until these are set, /privacy-policy renders a visible
# "configuration incomplete" warning and shows placeholder text.
#
# Unlike the rest of this file these lines are NOT commented out, because a
# missing value here is a legal exposure, not a disabled feature.

# Registered legal entity of the Data Fiduciary, exactly as incorporated.
DPDP_LEGAL_ENTITY=
# Registered office address, as filed.
DPDP_REGISTERED_ADDRESS=
# Optional corporate identifiers, printed in the notice when present.
DPDP_CIN=
DPDP_GSTIN=

# Grievance Officer — section 13. Must be a real, monitored mailbox.
DPDP_GRIEVANCE_OFFICER_NAME=
DPDP_GRIEVANCE_OFFICER_EMAIL=
DPDP_GRIEVANCE_OFFICER_DESIGNATION=Grievance Officer
DPDP_GRIEVANCE_OFFICER_PHONE=
DPDP_GRIEVANCE_OFFICER_ADDRESS=

# Days to resolve a grievance. The DPDP Rules cap this at 90; we publish 30.
# Whatever you put here is published in the notice and stamped on every
# grievance as a deadline, so do not set a number you cannot meet.
DPDP_GRIEVANCE_SLA_DAYS=30

# Data Protection Officer — only required if the Central Government notifies
# the company as a Significant Data Fiduciary under section 10. Leave blank.
DPDP_DPO_NAME=
DPDP_DPO_EMAIL=
DPDP_SIGNIFICANT_DATA_FIDUCIARY=false

# Version stamp for the privacy notice. CHANGING THIS INVALIDATES EVERY
# STORED COOKIE CONSENT and re-prompts every visitor — which is the correct
# behaviour when the notice materially changes, and disruptive otherwise.
# Bump it only when what you actually do with personal data changes.
NEXT_PUBLIC_PRIVACY_NOTICE_VERSION=2026-10-01.1

# Required by /api/cron/data-retention, which enforces the published retention
# schedule. Minimum 16 characters.
# CRON_SECRET=
