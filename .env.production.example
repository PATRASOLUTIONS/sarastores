# ---------------------------------------------------------------------------
# SARA Electronics — production environment template
#
# Copy these into the Vercel project (Settings -> Environment Variables) for the
# Production environment. Values here are PLACEHOLDERS — never commit real ones.
# Replace every required placeholder before enabling production traffic.
# Do not copy UAT payment credentials into this production configuration.
# After setting values, run npm run check:deployment, then redeploy.
# That command checks presence/syntax only; test provider journeys separately.
# ---------------------------------------------------------------------------

# --- Required: the app will not start or will silently misbehave without these

# Throws at module load in lib/mongodb.ts if absent.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority"
# Use the intended database. Checkout requires replica-set transactions.
MONGODB_DB="e-commerce-bytewise"
# Optional pool tuning; defaults are 3 connections and a 5000 ms selection timeout.
# MONGODB_MAX_POOL_SIZE=3
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Signs the session cookie. Must be >= 16 chars; 32+ recommended.
# If missing in production every session verifies as null (nobody can log in).
SESSION_SECRET="<64-char-random-string>"
# NEXTAUTH_SECRET is a legacy fallback; it is not required with SESSION_SECRET.
# COOKIE_DOMAIN is normally unnecessary for a same-origin website.
# COOKIE_DOMAIN=".sarastores.com"

# Canonical origin. Used by canonicals, sitemap, robots, OG images, email links
# and the Google OAuth redirect. Without it those fall back to the Vercel
# preview URL or http://localhost:3000, which breaks verification emails and SEO.
NEXT_PUBLIC_SITE_URL="https://sarastores.com"
NEXT_PUBLIC_APP_URL="https://sarastores.com"
NEXTAUTH_URL="https://sarastores.com"

# Partnership celebration. Hidden until this ISO-8601 instant, then shown once.
# Clear HANDSHAKE_LAUNCH_AT to turn it off. Times should include the offset.
# HANDSHAKE_LAUNCH_AT="2026-10-16T15:30:00+05:30"
# HANDSHAKE_PARTNER_URL="https://bytewiseconsulting.in"
# HANDSHAKE_STORE_URL="https://sarastores.com"

# --- Required public legal disclosures. Supply owner-approved values.
DPDP_LEGAL_ENTITY="<registered-legal-entity>"
DPDP_REGISTERED_ADDRESS="<registered-office-address>"
DPDP_GRIEVANCE_OFFICER_NAME="<named-grievance-officer>"
DPDP_GRIEVANCE_OFFICER_EMAIL="<grievance-officer-email>"
# Optional disclosures; add only owner-approved details.
# DPDP_CIN=
# DPDP_GSTIN=
# DPDP_GRIEVANCE_OFFICER_DESIGNATION="Grievance Officer"
# DPDP_GRIEVANCE_OFFICER_PHONE=
# DPDP_GRIEVANCE_OFFICER_ADDRESS=
DPDP_GRIEVANCE_SLA_DAYS=30
DPDP_SIGNIFICANT_DATA_FIDUCIARY=false
# Required only when designated a Significant Data Fiduciary.
# DPDP_DPO_NAME=
# DPDP_DPO_EMAIL=
NEXT_PUBLIC_PRIVACY_NOTICE_VERSION="2026-10-01.1"

# Shared counters are required in production; memory is refused.
# MongoDB requires index creation plus read/write access to rate_limits.
RATE_LIMIT_BACKEND="mongodb"
# To select Upstash instead, set RATE_LIMIT_BACKEND="upstash" and both values.
# UPSTASH_REDIS_REST_URL="https://<upstash-rest-endpoint>"
# UPSTASH_REDIS_REST_TOKEN="<upstash-rest-token>"

# --- Website checkout gateways (server-side flags, exactly true or false).
# Only enabled providers appear as logo choices. Keep unused providers false.
# Pine Labs is first by default when enabled; this explicit setting selects it.
# To disable Pine Labs, also change PAYMENT_DEFAULT_PROVIDER to an enabled one.
RAZORPAY_ENABLED=true
PINELABS_ENABLED=true
PAYTM_ENABLED=false
# Set false to hide Cash on Delivery and reject new COD orders.
COD_ENABLED=true
PAYMENT_DEFAULT_PROVIDER=pinelabs

# Razorpay: required only when RAZORPAY_ENABLED=true.
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="<razorpay-live-secret>"

# Pine Labs / Plural: all four credentials are required when enabled.
# Obtain matching LIVE credentials and go-live approval from Pine Labs.
PINELABS_ENVIRONMENT=production
PINELABS_MERCHANT_ID="<pinelabs-live-merchant-id>"
PINELABS_CLIENT_ID="<pinelabs-live-oauth-client-id>"
PINELABS_CLIENT_SECRET="<pinelabs-live-oauth-client-secret>"
# Hexadecimal secret_key for hosted-checkout return-signature verification.
# Ask onboarding which key to use; do not assume the OAuth secret is this key.
# Never generate a substitute or leave this blank with Pine Labs enabled.
PINELABS_CALLBACK_SECRET="<pinelabs-live-hex-callback-signing-key>"

# Paytm: keep disabled until live MID, 16-byte merchant key and approval exist.
PAYTM_ENVIRONMENT=production
PAYTM_MERCHANT_ID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE_NAME=DEFAULT

# Register these URLs with EACH enabled hosted provider, using your live origin:
# /api/payment/pinelabs/return  and /api/payment/pinelabs/webhook
# /api/payment/paytm/return    and /api/payment/paytm/webhook
# See documents/operations/website-payment-gateways.md for onboarding details.

# --- Email (Nodemailer). Without these, order confirmations, email
# verification and password resets silently fail — sends are wrapped in
# try/catch so orders still succeed, but the customer never hears from you.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="<smtp-username>"
SMTP_PASS="<smtp-password>"
EMAIL_FROM="SARA Electronics <noreply@sarastores.com>"
CONTACT_ADMIN_EMAIL="sales@sarastores.com"
VENDOR_EMAIL="sales@sarastores.com"

# --- Scheduled jobs. Required by every /api/cron/* route (>= 16 chars).
# Routes answer 503 when unset, 401 on a wrong value.
CRON_SECRET="<48-char-random-string>"

# --- Bot protection. reCAPTCHA verification is SKIPPED when the secret is
# absent, so set both to keep signup/login protected beyond the IP rate limit.
# Use a matching reCAPTCHA v3 pair and allow your live hostname in Google.
# NEXT_PUBLIC values are bundled at build time; redeploy after changing them.
# true enforces CAPTCHA on website login/signup; false skips Google only.
# Use a matching reCAPTCHA v3 pair registered for your deployed hostname.
RECAPTCHA_ENABLED=true
RECAPTCHA_SECRET_KEY="<recaptcha-v3-secret>"
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="<recaptcha-v3-site-key>"

# --- Admin seeding (npm run seed:admin). Remove after the first admin exists.
ADMIN_EMAIL="admin@sarastores.com"
ADMIN_PASSWORD="<strong-password>"

# --- Partner API (only if the partner surface is in use)
PARTNER_API_KEY_SECRET="<32-char-random-string>"
API_KEY_ENCRYPTION_SECRET="<32+-char-random-string>"
PARTNER_ALLOWED_ORIGINS="https://partner-one.example,https://partner-two.example"

# --- eXlr8 / KGen integration (only if in use).
# The webhook fails closed with HTTP 500 until this is set.
EXLR8_BASE_URL="https://<exlr8-host>"
EXLR8_CLIENT_ID="<client-id>"
EXLR8_CLIENT_SECRET="<client-secret>"
EXLR8_WEBHOOK_SECRET="<shared-webhook-secret>"
# Optional distributor identity if required by your eXlr8 account.
# EXLR8_DP_ID=
# EXLR8_DP is a supported legacy alias; use only one distributor setting.

# --- WhatsApp (AskEva) — spin wheel and marketing notifications
ASKEVA_API_KEY="<askeva-api-key>"
ASKEVA_API_URL="https://<askeva-host>/api"
ASKEVA_SENDER_NUMBER="<sender-number>"
# Approved utility template with six body parameters; see documents/features/order-confirmation-whatsapp.md.
ORDER_CONFIRMATION_WHATSAPP_TEMPLATE="sara_order_confirmed_v2"
ORDER_CONFIRMATION_WHATSAPP_LANGUAGE="en"
# Campaign sends require explicit operator confirmation as well as this flag.
WHATSAPP_CAMPAIGNS_ENABLED=false

# --- Google OAuth (only if social sign-in is enabled)
GOOGLE_CLIENT_ID="<google-client-id>"
GOOGLE_CLIENT_SECRET="<google-client-secret>"
GOOGLE_REDIRECT_URI="https://sarastores.com/api/auth/google/callback"
# Optional audiences for native Google sign-in, not required for web checkout.
# GOOGLE_IOS_CLIENT_ID=
# GOOGLE_ANDROID_CLIENT_ID=
# GOOGLE_EXPO_CLIENT_ID=

# --- Feature flags. Keep ENABLE_DEBUG_ROUTES unset or "false" in production:
# it gates /api/debug/*, /api/test-*, /api/seed-* and /api/clear_database.
ENABLE_DEBUG_ROUTES="false"
DEBUG_SHOW_COOKIE="false"
NEXT_PUBLIC_ENABLE_PWA_SW="false"

# --- Optional consent-gated analytics. Configure GTM OR direct GA4, not both.
# NEXT_PUBLIC_GTM_ID=
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_CLARITY_ID=

# --- Optional native-app universal/app links.
# IOS_APP_ID="<apple-team-id>.<bundle-id>"
# ANDROID_PACKAGE_NAME=
# ANDROID_SHA256_FINGERPRINTS=

# --- Media ingestion: only the local driver is currently implemented.
# MEDIA_DRIVER=local
# Do not enable local disk uploads on Vercel's read-only serverless filesystem.
# Durable production media storage requires a supported storage implementation.
# NODE_ENV, NEXT_RUNTIME and VERCEL_URL are supplied by the hosting platform.

# --- Misc
REVOKE_PASSWORD="<admin-revoke-password>"
AMAZON_SCRAPER_WORD="<scraper-passphrase>"
NEXT_PUBLIC_GOOGLE_SHEET_PRICE_SYNC_ID="<google-sheet-id>"
