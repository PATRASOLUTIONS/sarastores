# ---------------------------------------------------------------------------
# SARA Electronics — production environment template
#
# Copy these into the Vercel project (Settings -> Environment Variables) for the
# Production environment. Values here are PLACEHOLDERS — never commit real ones.
#
# Verified against actual process.env usage in the codebase. Prefer this file
# over .env.example, which is out of date (every line commented out, and it
# declares SMTP_PASSWORD while the code reads SMTP_PASS).
# ---------------------------------------------------------------------------

# --- Required: the app will not start or will silently misbehave without these

# Throws at module load in lib/mongodb.ts if absent.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority"

# Signs the session cookie. Must be >= 16 chars; 32+ recommended.
# If missing in production every session verifies as null (nobody can log in).
SESSION_SECRET="<64-char-random-string>"

# Canonical origin. Used by canonicals, sitemap, robots, OG images, email links
# and the Google OAuth redirect. Without it those fall back to the Vercel
# preview URL or http://localhost:3000, which breaks verification emails and SEO.
NEXT_PUBLIC_SITE_URL="https://sarastores.com"
NEXT_PUBLIC_APP_URL="https://sarastores.com"
NEXTAUTH_URL="https://sarastores.com"

# --- Payments (Razorpay). Use rzp_live_* keys in production.
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="<razorpay-live-secret>"

# --- Email (Nodemailer). Without these, order confirmations, email
# verification and password resets silently fail — sends are wrapped in
# try/catch so orders still succeed, but the customer never hears from you.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="<smtp-username>"
SMTP_PASS="<smtp-password>"
EMAIL_FROM="SARA Electronics <noreply@sarastores.com>"
CONTACT_ADMIN_EMAIL="sales@sarastores.com"
VENDOR_EMAIL="sales@sarastores.com"

# --- Scheduled jobs. Required by every /api/cron/* route (>= 16 chars).
# Routes answer 503 when unset, 401 on a wrong value.
CRON_SECRET="<48-char-random-string>"

# --- Bot protection. reCAPTCHA verification is SKIPPED when the secret is
# absent, so set both to keep signup/login protected beyond the IP rate limit.
RECAPTCHA_SECRET_KEY="<recaptcha-v3-secret>"
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="<recaptcha-v3-site-key>"

# --- Admin seeding (npm run seed:admin). Remove after the first admin exists.
ADMIN_EMAIL="admin@sarastores.com"
ADMIN_PASSWORD="<strong-password>"

# --- Partner API (only if the partner surface is in use)
PARTNER_API_KEY_SECRET="<32-char-random-string>"
API_KEY_ENCRYPTION_SECRET="<32+-char-random-string>"
PARTNER_ALLOWED_ORIGINS="https://partner-one.example,https://partner-two.example"

# --- eXlr8 / KGen integration (only if in use).
# The webhook fails closed with HTTP 500 until this is set.
EXLR8_BASE_URL="https://<exlr8-host>"
EXLR8_CLIENT_ID="<client-id>"
EXLR8_CLIENT_SECRET="<client-secret>"
EXLR8_WEBHOOK_SECRET="<shared-webhook-secret>"

# --- WhatsApp (AskEva) — spin wheel and marketing notifications
ASKEVA_API_KEY="<askeva-api-key>"
ASKEVA_API_URL="https://<askeva-host>/api"
ASKEVA_SENDER_NUMBER="<sender-number>"

# --- Google OAuth (only if social sign-in is enabled)
GOOGLE_CLIENT_ID="<google-client-id>"
GOOGLE_CLIENT_SECRET="<google-client-secret>"
GOOGLE_REDIRECT_URI="https://sarastores.com/api/auth/google/callback"

# --- Feature flags. Keep ENABLE_DEBUG_ROUTES unset or "false" in production:
# it gates /api/debug/*, /api/test-*, /api/seed-* and /api/clear_database.
ENABLE_DEBUG_ROUTES="false"
NEXT_PUBLIC_ENABLE_PWA_SW="false"

# --- Misc
REVOKE_PASSWORD="<admin-revoke-password>"
AMAZON_SCRAPER_WORD="<scraper-passphrase>"
NEXT_PUBLIC_GOOGLE_SHEET_PRICE_SYNC_ID="<google-sheet-id>"
