# ---------------------------------------------------------------------------
# LOCAL TEST OVERRIDES  ·  created for automated UI/API testing
#
# Next.js loads this file LAST for `next dev`, so it overrides .env.local and
# .env without modifying either of them. Delete this file to restore the
# original behaviour.
#
# Purpose: keep `npm run dev` away from production. The repo's .env points at
# the live Atlas cluster with a LIVE Razorpay key and a working Gmail SMTP
# account, which makes automated button-clicking genuinely destructive.
# ---------------------------------------------------------------------------

# --- Database: isolated test cluster -----------------------------------------
MONGODB_URI="mongodb+srv://admin:admin@pmd.hp26d.mongodb.net/?retryWrites=true&w=majority&appName=pmd"
DB_NAME="e-commerce-bytewise"
MONGODB_DB="e-commerce-bytewise"

# --- Email: hard-disabled -----------------------------------------------------
# Points at a closed local port so every send fails instantly with ECONNREFUSED
# instead of relaying through the real Gmail account.
SMTP_HOST="127.0.0.1"
SMTP_PORT="1"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="test@localhost"
CONTACT_ADMIN_EMAIL="test@localhost"
VENDOR_EMAIL="test@localhost"

# --- Payments: live key neutralised ------------------------------------------
# The repo .env carries an rzp_live_* key. These placeholders keep the checkout
# UI rendering (so the buttons can be exercised) while making a real charge
# impossible. Substitute genuine rzp_test_* keys to exercise the gateway leg.
RAZORPAY_KEY_ID="rzp_test_0000000000"
RAZORPAY_KEY_SECRET="test_secret_placeholder"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_0000000000"
RAZORPAY_ENABLED="true"
PINELABS_ENABLED="false"
PAYTM_ENABLED="false"
PAYMENT_DEFAULT_PROVIDER="razorpay"
# COD gives a complete, gateway-free order path for end-to-end testing.
COD_ENABLED="true"

# --- Outbound messaging: inert ------------------------------------------------
ASKEVA_API_KEY=""
ASKEVA_API_URL=""
ASKEVA_SENDER_NUMBER=""
WHATSAPP_CAMPAIGNS_ENABLED="false"

# --- External fulfilment: inert ----------------------------------------------
EXLR8_BASE_URL=""
EXLR8_CLIENT_ID=""
EXLR8_CLIENT_SECRET=""
EXLR8_WEBHOOK_SECRET=""

# --- Local origin -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3005"
NEXT_PUBLIC_APP_URL="http://localhost:3005"
NEXTAUTH_URL="http://localhost:3005"

# --- Test ergonomics ----------------------------------------------------------
RECAPTCHA_ENABLED="false"
NEXT_PUBLIC_ENABLE_PWA_SW="false"
MEDIA_DRIVER="local"
ENABLE_DEBUG_ROUTES="false"
