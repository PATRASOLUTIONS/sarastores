# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# env files (contain secrets) — keep .env.example tracked
.env
.env.local
.env.*.local
.env.development
.env.production
!.env.example

# next.js
/.next/
/.next-build-check/
/.next-audit/
/.next-audit-strict/
/.next-audit-dev/
/out/

# locally stored product media (MEDIA_DRIVER=local); real deployments use R2
/public/media/
.scrape-probe/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# one-off debug dumps — these contain real customer PII (name, email, phone, address)
order_dump.json
order_debug_dump.json
sweep-*.txt
*.tmp.txt



# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# DPDP: never commit personal data dumps or debug exports.
# These files previously contained real customer names, emails, phones and addresses.
order_dump.json
order_debug_dump.json
*_dump.json
*_debug_dump.json
/dumps/
/exports/

# Local audit output and historical logs are not application source.
/scripts/audit/
/scripts/archive/
/documents/private-artifacts/

# Playwright writes a trace, screenshot and video per test on every run.
/e2e/.artifacts/
/e2e/.report/
/playwright-report/
/test-results/

# Captured stdout from a local server or test run.
/e2e-run.log
/prod-server.log
